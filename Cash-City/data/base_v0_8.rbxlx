      <Item class="LocalScript" referent="RBX143">
        <Properties>
          <string name="Name">SmallSignalsClient</string>
          <ProtectedString name="Source">
local function armyStyle(object,radius)
    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,radius or 10)
    corner.Parent=object
    local stroke=Instance.new("UIStroke")
    stroke.Color=Color3.fromRGB(29,40,25)
    stroke.Thickness=3
    stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    stroke.Parent=object
end
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")
local player = Players.LocalPlayer
local package = RS:WaitForChild("SmallSignals")
local remote, state = package:WaitForChild("Action"), package:WaitForChild("State")
local config = require(package.Config)
local fieldHUD = require(script.Parent:WaitForChild("SmallSignalsHUD")).new(player,config)
local selectedSize, selectedWeapon = 3, "Rifle"
local snapshot = {phase="Lobby",message="Connecting…",deadline=0,teams={Amber={},Cyan={}}}
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "SmallSignalsUI", false, false
gui.Parent = player:WaitForChild("PlayerGui")
local function label(parent,text,size,pos,height)
    local v=Instance.new("TextLabel")
    v.BackgroundTransparency=1
    v.TextColor3=Color3.fromRGB(255,246,211)
    v.Font=size&gt;=20 and Enum.Font.FredokaOne or Enum.Font.GothamBold
    v.TextSize=size
    v.TextStrokeColor3=Color3.fromRGB(29,40,25)
    v.TextStrokeTransparency=0.65
    v.TextWrapped=true
    v.TextXAlignment=Enum.TextXAlignment.Left
    v.Size,v.Position=UDim2.new(1,-32,0,height or 32),UDim2.fromOffset(16,pos)
    v.Text,v.Parent=text,parent
    return v
end
local function frame(size,pos)
    local f=Instance.new("Frame")
    f.Size,f.Position=size,pos
    f.BackgroundColor3=Color3.fromRGB(73,94,49)
    f.BackgroundTransparency=0
    f.Parent=gui
    armyStyle(f,14)
    return f
end
local menu=frame(UDim2.fromOffset(560,400),UDim2.new(0.05,0,0.5,-200))
local constraint=Instance.new("UISizeConstraint") constraint.MaxSize=Vector2.new(560,440) constraint.Parent=menu
menu.AnchorPoint=Vector2.new(0.5,0.5) menu.Position=UDim2.fromScale(0.5,0.5)
label(menu,"★ SQUAD UP! ★",30,12)
label(menu,"SMALL SIGNALS • CARTOON BARRACKS",15,48)
local status=label(menu,"",16,82,60)
local function button(parent,text,x,y,w,callback)
    local b=Instance.new("TextButton")
    b.Size,b.Position=UDim2.new(w, -8,0,42),UDim2.new(x,4,0,y)
    b.Text,b.Font,b.TextSize=text,Enum.Font.FredokaOne,17
    b.BackgroundColor3,b.TextColor3=Color3.fromRGB(118,145,67),Color3.fromRGB(240,245,250)
    b.Parent=parent
    armyStyle(b,10)
    b.Activated:Connect(callback)
    return b
end
local sizeButtons={}
for i,n in ipairs({3,4,5}) do
    sizeButtons[n]=button(menu,n.." vs "..n,(i-1)/3,155,1/3,function()
        selectedSize=n
        for size,b in pairs(sizeButtons) do
            b.BackgroundColor3=size==n and Color3.fromRGB(194,158,64) or Color3.fromRGB(118,145,67)
            b.Text=(size==n and "★ " or "")..size.." vs "..size
        end
    end)
end
sizeButtons[3].BackgroundColor3=Color3.fromRGB(194,158,64)
sizeButtons[3].Text="★ 3 vs 3"
local ready=button(menu,"READY TO DEPLOY",0,212,0.5,function() remote:FireServer("Ready",selectedSize) end)
local unready=button(menu,"LEAVE QUEUE",0.5,212,0.5,function() remote:FireServer("Unready") end)
local practiceButton=button(menu,"SOLO STUDIO TEST",0,266,1,function() remote:FireServer("Practice") end)
practiceButton.Visible=RunService:IsStudio()
label(menu,"3 DOORS • ONE SQUAD • EVERYONE EXTRACTS",14,321,34)
local queueHint=label(menu,"3v3 needs 6 ready players. Solo testing is Studio-only.",12,357,32)
local vote=frame(UDim2.fromOffset(560,440),UDim2.fromScale(0.5,0.5))
vote.AnchorPoint=Vector2.new(0.5,0.5)
local vc=Instance.new("UISizeConstraint") vc.MaxSize=Vector2.new(560,440) vc.Parent=vote
label(vote,"★ GEAR UP! ★",22,12,38)
label(vote,"Pick your preferred gun, then vote for your squad carrier.",14,56,38)
local weaponButtons={}
local function chooseWeapon(name)
    selectedWeapon=name
    remote:FireServer("Weapon",name)
    for weapon,b in pairs(weaponButtons) do
        b.Text=(weapon==name and "★ " or "")..string.upper(weapon)
        b.BackgroundColor3=weapon==name and Color3.fromRGB(194,158,64) or Color3.fromRGB(118,145,67)
    end
end
weaponButtons.Rifle=button(vote,"★ RIFLE",0,100,0.5,function() chooseWeapon("Rifle") end)
weaponButtons.SMG=button(vote,"SMG",0.5,100,0.5,function() chooseWeapon("SMG") end)
weaponButtons.Rifle.BackgroundColor3=Color3.fromRGB(194,158,64)
local weaponLabel=label(vote,"Your preferred weapon: Rifle",14,149)
local nominees=Instance.new("Frame")
nominees.BackgroundTransparency=1 nominees.Size=UDim2.new(1,0,0,250) nominees.Position=UDim2.fromOffset(0,188) nominees.Parent=vote
local lastNominees=""
local menuScale=Instance.new("UIScale") menuScale.Parent=menu
local voteScale=Instance.new("UIScale") voteScale.Parent=vote
menu.Visible,vote.Visible=true,false
local lobbyClosed,voteClosed=false,false
local reopen
local function refreshPanels()
    local lobbyAvailable=snapshot.phase=="Lobby" or (snapshot.phase=="Match" and player.Neutral)
    local voteAvailable=snapshot.phase=="Vote" and not player.Neutral
    menu.Visible=lobbyAvailable and not lobbyClosed
    vote.Visible=voteAvailable and not voteClosed
    if reopen then
        reopen.Visible=(lobbyAvailable and lobbyClosed) or (voteAvailable and voteClosed)
        if voteAvailable then
            local seconds=math.max(0,math.ceil((snapshot.deadline or 0)-workspace:GetServerTimeNow()))
            reopen.Text="GEAR UP • "..seconds.."s"
        elseif snapshot.ready then
            local needed=snapshot.teamSize==1 and 1 or (snapshot.teamSize or 3)*2
            reopen.Text="WAITING • "..(snapshot.queueCount or 0).."/"..needed
        else reopen.Text="SQUAD LOBBY" end
    end
end
local function closeButton(panel,callback)
    local b=button(panel,"X",0,0,0.1,callback)
    b.Name,b.AnchorPoint,b.Size,b.Position="ClosePanel",Vector2.new(1,0),UDim2.fromOffset(40,34),UDim2.new(1,-10,0,10)
    b.BackgroundColor3=Color3.fromRGB(157,77,53)
end
closeButton(menu,function() lobbyClosed=true refreshPanels() end)
closeButton(vote,function() voteClosed=true refreshPanels() end)
reopen=button(gui,"SQUAD LOBBY",0,110,0.2,function()
    if snapshot.phase=="Vote" and not player.Neutral then voteClosed=false else lobbyClosed=false end
    refreshPanels()
end)
reopen.Name,reopen.Size,reopen.Position,reopen.Visible="ReopenSquadPanel",UDim2.fromOffset(210,42),UDim2.fromOffset(14,110),false

local banner=label(gui,"",20,0,70)
banner.TextXAlignment=Enum.TextXAlignment.Center banner.Position=UDim2.new(0.1,0,0.7,0) banner.Size=UDim2.new(0.8,0,0,70)
local crosshair=label(gui,"+",22,0,28)
crosshair.TextXAlignment=Enum.TextXAlignment.Center crosshair.Size=UDim2.fromOffset(28,28) crosshair.Position=UDim2.new(0.5,-14,0.5,-14)
local hint=label(gui,"Equip: 1 / 2 • Fire: click • Reload: R • Enter / revive: hold E",13,0,30)
hint.Visible=false
hint.Position=UDim2.new(0.03,0,1,-35) hint.Size=UDim2.new(0.94,0,0,30)
crosshair.Name="Crosshair"
banner.Name="RoundNotice"
fieldHUD:RegisterPanel(crosshair)
fieldHUD:RegisterPanel(banner)
local mouse=player:GetMouse()
local firing=false
local function shoot()
    if fieldHUD:IsEditing() then return end
    if snapshot.phase~="Match" then return end
    local camera=workspace.CurrentCamera
    if not camera then return end
    local position=UIS:GetMouseLocation()
    if UIS.TouchEnabled then position=camera.ViewportSize/2 end
    local ray=camera:ViewportPointToRay(position.X,position.Y)
    local params=RaycastParams.new()
    params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{player.Character}
    local hit=workspace:Raycast(ray.Origin,ray.Direction*500,params)
    remote:FireServer("Attack",hit and hit.Position or ray.Origin+ray.Direction*500)
end
UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.UserInputType==Enum.UserInputType.MouseButton1 then firing=true
    elseif input.KeyCode==Enum.KeyCode.R and not fieldHUD:IsEditing() then remote:FireServer("Reload") end
end)
UIS.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then firing=false end end)
local fire=button(gui,"FIRE",0.79,0,0.18,shoot)
fire.Position=UDim2.new(0.79,0,0.65,0) fire.Visible=UIS.TouchEnabled
local reload=button(gui,"RELOAD",0.79,0,0.18,function() if not fieldHUD:IsEditing() then remote:FireServer("Reload") end end)
reload.Position=UDim2.new(0.79,0,0.65,52) reload.Visible=UIS.TouchEnabled
fire.Name,reload.Name="FireControl","ReloadControl"
fieldHUD:RegisterPanel(fire)
fieldHUD:RegisterPanel(reload)
state.OnClientEvent:Connect(function(data)
    if data.phase~=snapshot.phase then
        if data.phase=="Vote" then voteClosed=false end
        if data.phase=="Lobby" then lobbyClosed=false end
    end
    snapshot=data
    refreshPanels()
    ready.Text=data.ready and "QUEUED — "..data.teamSize.."v"..data.teamSize or "READY TO DEPLOY"
    queueHint.Text=selectedSize.."v"..selectedSize.." needs "..(selectedSize*2).." ready players. Solo testing is Studio-only."
    local needed=data.teamSize==1 and 1 or (data.teamSize or 3)*2
    status.Text=data.message..(data.ready and ("\nWaiting: "..(data.queueCount or 0).." / "..needed.." ready. Close this panel to explore.") or "")
    weaponLabel.Text="Your preferred weapon: "..selectedWeapon
    local team=player.Team and player.Team.Name
    local rows=team and data.teams[team] or {}
    local signature=""
    for _,row in ipairs(rows) do signature=signature..row.id..":" end
    if signature~=lastNominees then
        lastNominees=signature
        nominees:ClearAllChildren()
        for i,row in ipairs(rows) do
            button(nominees,row.name,0,(i-1)*46,1,function()
                remote:FireServer("Nominate",row.id)
                weaponLabel.Text="Voted for "..row.name.." • your gun: "..selectedWeapon
            end)
        end
    end
end)
local elapsed=0
RunService.RenderStepped:Connect(function(dt)
    elapsed=elapsed+dt
    if firing and elapsed&gt;=0.08 then elapsed=0 shoot() end
    local camera=workspace.CurrentCamera
    if camera then
        local viewport=camera.ViewportSize
        menuScale.Scale=math.max(0.35,math.min(1,(viewport.X-40)/560,(viewport.Y-90)/400))
        voteScale.Scale=math.max(0.35,math.min(1,(viewport.X-40)/560,(viewport.Y-90)/440))
    end
    refreshPanels()
    local phase=snapshot.phase
    local team=player.Team and player.Team.Name or "Spectator"
    local stage=player:GetAttribute("Stage") or 0
    local char=player.Character
    local h=char and char:FindFirstChildOfClass("Humanoid")
    local r=char and char:FindFirstChild("HumanoidRootPart")
    local remaining=math.max(0,math.ceil((snapshot.deadline or 0)-workspace:GetServerTimeNow()))
    fieldHUD:Update(snapshot)
    crosshair.Visible=phase=="Match"
    banner.Text=player:GetAttribute("Downed") and "DOWNED — a teammate can revive you" or phase=="Results" and snapshot.message or ""
    if workspace.CurrentCamera then
        player.CameraMinZoomDistance=math.max(0.15,0.5*(player:GetAttribute("Scale") or 1))
        player.CameraMaxZoomDistance=math.max(3,16*(player:GetAttribute("Scale") or 1))
    end
    -- Each client sees clues for its own next door, not a teammate's later door.
    local arena=workspace:FindFirstChild("SmallSignalsArena")
    local interactions=arena and arena:FindFirstChild("RoundInteractions")
    if interactions then
        for _,door in ipairs(interactions:GetChildren()) do
            local prompt=door:FindFirstChildWhichIsA("ProximityPrompt",true)
            local valid=phase=="Match" and door:GetAttribute("Team")==team and not player:GetAttribute("Downed")
            if door.Name=="ArmorCache" then
                local ownerId=door:GetAttribute("OwnerId")
                local ownerTeam=door:GetAttribute("OwnerTeam")
                valid=phase=="Match" and not player.Neutral and not player:GetAttribute("Downed")
                    and door:GetAttribute("Stage")==stage and (ownerId==player.UserId or ownerTeam~=team)
                local distance=r and (r.Position-door.Position).Magnitude or math.huge
                door.LocalTransparencyModifier=valid and distance&lt;24 and 0 or 1
                valid=valid and (player:GetAttribute("Armor") or 0)&lt;(player:GetAttribute("MaxArmor") or 0)
                if prompt then prompt.ActionText=ownerId==player.UserId and "Equip armor" or "Steal armor" end
            elseif door.Name=="TransitDoor" then
                valid=phase=="Match" and not player.Neutral and not player:GetAttribute("Downed")
            elseif door.Name=="Door" then
                valid=valid and door:GetAttribute("Stage")==stage+1
                local distance=r and (r.Position-door.Position).Magnitude or math.huge
                local reveal=state:GetAttribute("Overtime") and 110 or 50
                local visible=valid and distance&lt;reveal
                door.LocalTransparencyModifier=visible and 0 or 1
                for _,piece in ipairs(door:GetDescendants()) do
                    if piece:IsA("BasePart") then piece.LocalTransparencyModifier=visible and 0 or 1 end
                    if piece:IsA("BillboardGui") then piece.Enabled=visible end
                end
            else valid=valid and stage==config.Stages end
            if prompt then prompt.Enabled=valid end
        end
    end
end)
-- UI hiding is supplemental: server TextChannels also reject delivery.
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false) end)
pcall(function()
    TextChatService.ChatWindowConfiguration.Enabled=false
    TextChatService.ChatInputBarConfiguration.Enabled=false
    TextChatService.BubbleChatConfiguration.Enabled=false
end)

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health,false) end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXFieldHUDModule">
        <Properties>
          <string name="Name">SmallSignalsHUD</string>
          <ProtectedString name="Source">
local function armyStyle(object,radius)
    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,radius or 10)
    corner.Parent=object
    local stroke=Instance.new("UIStroke")
    stroke.Color=Color3.fromRGB(29,40,25)
    stroke.Thickness=3
    stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    stroke.Parent=object
end
-- Small Signals field HUD. Presentation only; server owns every gameplay value.
local HUD={}
function HUD.new(player,config)
    local gui=Instance.new("ScreenGui")
    gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="SmallSignalsFieldHUD",false,5
    gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset=false
    gui.Parent=player:WaitForChild("PlayerGui")
    gui.Enabled=false
    local ink=Color3.fromRGB(73,94,49)
    local muted=Color3.fromRGB(227,218,171)
    local white=Color3.fromRGB(255,246,211)
    local olive=Color3.fromRGB(250,207,87)
    local blue=Color3.fromRGB(86,190,225)
    local function box(name,size,pos,anchor)
        local f=Instance.new("Frame")
        f.Name,f.Size,f.Position,f.AnchorPoint=name,size,pos,anchor or Vector2.new(0,0)
        f.BackgroundColor3,f.BackgroundTransparency,f.BorderSizePixel=ink,0,0
        f.Parent=gui
        armyStyle(f,12)
        local insignia=Instance.new("TextLabel")
        insignia.Name,insignia.Text,insignia.Font="ArmyBadge","★",Enum.Font.FredokaOne
        insignia.Size,insignia.Position=UDim2.fromOffset(22,22),UDim2.new(1,-26,0,-10)
        insignia.BackgroundColor3,insignia.TextColor3=Color3.fromRGB(52,68,36),olive
        insignia.TextSize,insignia.Parent=18,f
        armyStyle(insignia,6)
        return f
    end
    local function text(parent,name,value,x,y,w,h,size,color)
        local t=Instance.new("TextLabel")
        t.Name,t.Text,t.Position,t.Size=name,value,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h)
        t.BackgroundTransparency,t.Font,t.TextSize=1,Enum.Font.GothamBold,size or 14
        t.TextColor3,t.TextXAlignment,t.TextYAlignment=color or white,Enum.TextXAlignment.Left,Enum.TextYAlignment.Center
        t.TextTruncate=Enum.TextTruncate.AtEnd
        t.TextStrokeColor3=Color3.fromRGB(29,40,25)
        t.TextStrokeTransparency=0.65
        if (size or 14)&gt;=18 then t.Font=Enum.Font.FredokaOne end
        t.Parent=parent
        return t
    end
    local vital=box("Vitals",UDim2.fromOffset(330,138),UDim2.new(0,18,1,-48),Vector2.new(0,1))
    local callsign=text(vital,"Callsign","TOY SOLDIER",14,6,300,22,14,olive)
    local body=text(vital,"BodyScale","SIZE 100%",14,29,300,19,12,muted)
    local function bar(name,y,color)
        local title=text(vital,name.."Label",name,14,y,90,20,12,muted)
        local value=text(vital,name.."Value","0 / 0",215,y,100,20,14)
        value.TextXAlignment=Enum.TextXAlignment.Right
        local track=Instance.new("Frame")
        track.Name,track.Position,track.Size=name.."Track",UDim2.fromOffset(14,y+22),UDim2.fromOffset(301,9)
        track.BackgroundColor3,track.BorderSizePixel=Color3.fromRGB(38,54,32),0
        track.Parent=vital
        armyStyle(track,5)
        track.ClipsDescendants=true
        local fill=Instance.new("Frame")
        fill.Name,fill.Size,fill.BackgroundColor3,fill.BorderSizePixel="Fill",UDim2.fromScale(0,1),color,0
        fill.Parent=track
        return fill,value
    end
    local hpFill,hpText=bar("HEALTH",51,Color3.fromRGB(139,218,80))
    local apFill,apText=bar("ARMOR",91,blue)
    local objective=box("Objective",UDim2.fromOffset(350,66),UDim2.new(0.5,0,0,12),Vector2.new(0.5,0))
    local mission=text(objective,"Mission","MONROE BLOCK • DETROIT",14,5,320,19,12,muted)
    local progress=text(objective,"Progress","DOORS 0 / 3",14,26,230,30,19)
    local timer=text(objective,"Timer","00:00",244,26,90,30,20,olive)
    timer.TextXAlignment=Enum.TextXAlignment.Right
    local ammo=box("Loadout",UDim2.fromOffset(220,88),UDim2.new(1,-18,1,-48),Vector2.new(1,1))
    local gun=text(ammo,"Weapon","KNIFE",14,7,190,21,14,muted)
    local rounds=text(ammo,"Ammo","MELEE",14,30,190,40,28)
    local squad=box("Squad",UDim2.fromOffset(272,320),UDim2.new(1,-18,0,92),Vector2.new(1,0))
    text(squad,"Header","SQUAD / HEALTH / ARMOR",14,6,246,21,12,olive)
    local rows={}
    for i=1,5 do
        local y=32+(i-1)*56
        local row=Instance.new("Frame")
        row.Name,row.Size,row.Position="Member"..i,UDim2.fromOffset(244,52),UDim2.fromOffset(14,y)
        row.BackgroundTransparency,row.Parent=1,squad
        local name=text(row,"Name","",0,0,244,19,12)
        local values=text(row,"Values","",0,18,244,17,11,muted)
        local fills={}
        for index,color in ipairs({olive,blue}) do
            local track=Instance.new("Frame")
            track.Size,track.Position=UDim2.fromOffset(116,5),UDim2.fromOffset((index-1)*126,39)
            track.BackgroundColor3,track.BorderSizePixel,track.Parent=Color3.fromRGB(38,54,32),0,row
            local fill=Instance.new("Frame")
            fill.Size,fill.BackgroundColor3,fill.BorderSizePixel,fill.Parent=UDim2.fromScale(0,1),color,0,track
            fills[index]=fill
        end
        rows[i]={frame=row,name=name,values=values,hp=fills[1],armor=fills[2]}
    end
    local scales={}
    for _,panel in ipairs({vital,objective,ammo,squad}) do
        local scale=Instance.new("UIScale") scale.Parent=panel scales[panel]=scale
    end
    local settings=require(script.Parent:WaitForChild("SmallSignalsSettings")).new(player,{vital,objective,ammo,squad})
    local self={Gui=gui}
    function self:RegisterPanel(panel) settings:RegisterPanel(panel) end
    function self:IsEditing() return settings:IsEditing() end
    function self:Update(snapshot)
        local phase=snapshot.phase
        settings:Update()
        gui.Enabled=((phase=="Match" or phase=="Results") and not player.Neutral) or settings:IsEditing()
        if not gui.Enabled then return end
        local camera=workspace.CurrentCamera
        local width=camera and camera.ViewportSize.X or 1280
        scales[vital].Scale=math.clamp((width-48)/570,0.55,1)
        scales[ammo].Scale=scales[vital].Scale
        scales[objective].Scale=math.clamp((width-30)/350,0.65,1)
        scales[squad].Scale=math.clamp((width-30)/560,0.55,1)
        squad.Visible=settings:ShowSquad()
        local stage=player:GetAttribute("Stage") or 0
        local team=player.Team and player.Team.Name or "OPERATIVE"
        local char=player.Character
        local humanoid=char and char:FindFirstChildOfClass("Humanoid")
        local hp,maxHp=humanoid and humanoid.Health or 0,humanoid and humanoid.MaxHealth or 100
        local ap,maxAp=player:GetAttribute("Armor") or 0,player:GetAttribute("MaxArmor") or (config.Armor and config.Armor[stage+1]) or 0
        local down=player:GetAttribute("Downed")
        callsign.Text=string.upper(team).." / "..(down and "DOWNED" or "TOY SOLDIER")
        callsign.TextColor3=down and Color3.fromRGB(231,104,83) or olive
        body.Text=string.format("BODY SCALE %d%%  /  STAGE %d",math.floor((player:GetAttribute("Scale") or 1)*100+0.5),stage)
        hpFill.Size=UDim2.fromScale(math.clamp(hp/math.max(1,maxHp),0,1),1)
        hpFill.BackgroundColor3=hp/math.max(1,maxHp)&lt;=0.25 and Color3.fromRGB(204,76,58) or Color3.fromRGB(139,218,80)
        hpText.Text=string.format("%d / %d",math.ceil(hp),math.ceil(maxHp))
        apFill.Size=UDim2.fromScale(math.clamp(ap/math.max(1,maxAp),0,1),1)
        apText.Text=string.format("%d / %d",math.ceil(ap),math.ceil(maxAp))
        mission.Text=snapshot.practice and "STUDIO TRAINING / DETROIT" or "MONROE BLOCK • DETROIT"
        progress.Text=stage&gt;=config.Stages and "TEAM EXTRACTION" or string.format("DOORS %d / %d",stage,config.Stages)
        local remaining=math.max(0,math.ceil((snapshot.deadline or 0)-workspace:GetServerTimeNow()))
        timer.Text=string.format("%02d:%02d",math.floor(remaining/60),remaining%60)
        timer.TextColor3=remaining&lt;=30 and Color3.fromRGB(231,104,83) or olive
        local tool=char and char:FindFirstChildOfClass("Tool")
        local carrier=player:GetAttribute("Carrier")
        local weapon=tool and tool.Name or "HOLSTERED"
        gun.Text=string.upper(weapon)..(carrier and " / CARRIER" or "")
        rounds.Text=weapon=="Knife" and "MELEE" or weapon=="HOLSTERED" and "EQUIP 1 / 2" or tostring(player:GetAttribute("Ammo") or 0).." RDS"
        for i=1,5 do
            local row=((snapshot.teams or {})[team] or {})[i]
            rows[i].frame.Visible=row~=nil
            if row then
                local state=row.downed and "DOWN" or row.extracted and "EXIT" or tostring(row.stage).."/"..config.Stages
                rows[i].name.Text=state.."  "..row.name..(row.carrier and " *" or "")
                rows[i].name.TextColor3=row.downed and Color3.fromRGB(231,104,83) or white
                local known=type(row.health)=="number" and type(row.maxHealth)=="number"
                rows[i].values.Text=known and string.format("HP %d/%d   AR %d/%d",math.ceil(row.health),math.ceil(row.maxHealth),math.ceil(row.armor or 0),math.ceil(row.maxArmor or 0)) or "HP --   AR --"
                rows[i].hp.Size=UDim2.fromScale(known and math.clamp(row.health/math.max(1,row.maxHealth),0,1) or 0,1)
                rows[i].armor.Size=UDim2.fromScale(math.clamp((row.armor or 0)/math.max(1,row.maxArmor or 0),0,1),1)
            end
        end
    end
    function self:Destroy() settings:Destroy() gui:Destroy() end
    return self
end
return HUD
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="SS04_SmallSignalsSettings">
        <Properties>
          <string name="Name">SmallSignalsSettings</string>
          <ProtectedString name="Source">
local function armyStyle(object,radius)
    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,radius or 10)
    corner.Parent=object
    local stroke=Instance.new("UIStroke")
    stroke.Color=Color3.fromRGB(29,40,25)
    stroke.Thickness=3
    stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    stroke.Parent=object
end
-- Local preferences, preserved through respawn for this play session.
local Settings={}
function Settings.new(player,panels)
    local UIS=game:GetService("UserInputService")
    local GuiService=game:GetService("GuiService")
    local Lighting=game:GetService("Lighting")
    local SoundService=game:GetService("SoundService")
    local gui=Instance.new("ScreenGui")
    gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="SmallSignalsSettings",false,30
    gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset=false
    gui.Parent=player:WaitForChild("PlayerGui")
    local root=Instance.new("Frame")
    root.Size,root.BackgroundTransparency=UDim2.fromScale(1,1),1
    root.Parent=gui
    local connections={}
    local function connect(signal,fn) local c=signal:Connect(fn) table.insert(connections,c) return c end
    local editing,muted,low=false,false,false
    local drag=nil
    local defaults,handles={},{}
    local function button(parent,name,label,x,y,w,fn)
        local b=Instance.new("TextButton")
        b.Name,b.Text,b.Position,b.Size=name,label,UDim2.fromOffset(x,y),UDim2.fromOffset(w,32)
        b.BackgroundColor3,b.TextColor3=Color3.fromRGB(118,145,67),Color3.fromRGB(255,246,211)
        b.BorderSizePixel,b.Font,b.TextSize=0,Enum.Font.GothamBold,13
        b.Parent=parent
        armyStyle(b,9)
        connect(b.Activated,fn)
        return b
    end
    local window=Instance.new("Frame")
    window.Name,window.AnchorPoint,window.Position="SettingsPanel",Vector2.new(0.5,0.5),UDim2.fromScale(0.5,0.5)
    window.Size,window.BackgroundColor3,window.Visible=UDim2.fromOffset(310,290),Color3.fromRGB(73,94,49),false
    window.Parent=root
    armyStyle(window,14)
    local title=Instance.new("TextLabel")
    title.Size,title.Position,title.BackgroundTransparency=UDim2.fromOffset(280,32),UDim2.fromOffset(15,8),1
    title.Text,title.TextColor3,title.Font,title.TextSize="★ FIELD SETTINGS ★",Color3.fromRGB(250,207,87),Enum.Font.FredokaOne,20
    title.Parent=window
    local editButton,musicButton,graphicsButton,squadButton
    local squadWanted=true
    local function setEditing(value)
        editing=value drag=nil
        for _,handle in pairs(handles) do handle.Visible=value end
        if editButton then editButton.Text=value and "FINISH MOVING HUD" or "MOVE HUD PANELS" end
        window.Visible=not value
    end
    local open=button(root,"SettingsTab","SETTINGS",14,64,104,function()
        if editing then setEditing(false) else window.Visible=not window.Visible end
    end)
    connect(GuiService.MenuOpened,function()
        if editing then setEditing(false) end
        window.Visible=false
        gui.Enabled=false
    end)
    connect(GuiService.MenuClosed,function() gui.Enabled=true end)
    gui.Enabled=not GuiService.MenuIsOpen
    editButton=button(window,"EditHUD","MOVE HUD PANELS",15,49,280,function() setEditing(not editing) end)
    local musicSaved=setmetatable({},{__mode="k"})
    local graphicsSaved=setmetatable({},{__mode="k"})
    local function musicObject(obj)
        return (obj:IsA("SoundGroup") and obj.Name=="Music") or
            (obj:IsA("Sound") and (obj:GetAttribute("IsMusic")==true or obj.Name=="Music" or obj.Name=="BackgroundMusic"))
    end
    local function muteObject(obj)
        if muted and musicObject(obj) then
            if musicSaved[obj]==nil then musicSaved[obj]=obj.Volume end
            obj.Volume=0
        end
    end
    local function restoreMusic()
        for obj,value in pairs(musicSaved) do if obj.Parent then obj.Volume=value end musicSaved[obj]=nil end
    end
    musicButton=button(window,"MuteMusic","MUSIC: ON",15,89,280,function()
        muted=not muted
        musicButton.Text=muted and "MUSIC: MUTED" or "MUSIC: ON"
        if muted then for _,obj in ipairs(game:GetDescendants()) do muteObject(obj) end else restoreMusic() end
    end)
    local function reduce(obj)
        if not low then return end
        local prop
        if obj==Lighting then prop="GlobalShadows"
        elseif obj:IsA("PostEffect") then prop="Enabled"
        elseif obj:IsA("BasePart") then prop="CastShadow"
        elseif (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")) and obj:GetAttribute("LowGraphicsOptional")==true then prop="Enabled" end
        if prop then
            if not graphicsSaved[obj] then graphicsSaved[obj]={property=prop,value=obj[prop]} end
            obj[prop]=false
        end
    end
    local function restoreGraphics()
        for obj,saved in pairs(graphicsSaved) do
            if obj.Parent then obj[saved.property]=saved.value end
            graphicsSaved[obj]=nil
        end
    end
    graphicsButton=button(window,"LowGraphics","LOW GRAPHICS: OFF",15,129,280,function()
        low=not low
        graphicsButton.Text=low and "LOW GRAPHICS: ON" or "LOW GRAPHICS: OFF"
        if low then reduce(Lighting) for _,obj in ipairs(game:GetDescendants()) do reduce(obj) end else restoreGraphics() end
    end)
    squadButton=button(window,"ShowSquad","SQUAD PANEL: ON",15,169,280,function()
        squadWanted=not squadWanted
        squadButton.Text=squadWanted and "SQUAD PANEL: ON" or "SQUAD PANEL: OFF"
    end)
    button(window,"ResetLayout","RESET HUD POSITIONS",15,209,280,function()
        for panel,saved in pairs(defaults) do panel.AnchorPoint=saved.anchor panel.Position=saved.position panel:SetAttribute("CustomHUDPosition",false) end
    end)
    button(window,"Close","CLOSE",15,249,280,function() window.Visible=false end)
    local function clampPosition(panel,x,y)
        local size=root.AbsoluteSize
        return math.clamp(x,0,math.max(0,size.X-panel.AbsoluteSize.X)),math.clamp(y,0,math.max(0,size.Y-panel.AbsoluteSize.Y))
    end
    local function registerPanel(panel)
        defaults[panel]={anchor=panel.AnchorPoint,position=panel.Position}
        local handle=Instance.new("TextButton")
        handle.Name,handle.Size,handle.BackgroundColor3="MoveHandle",UDim2.new(1,0,0,22),Color3.fromRGB(196,155,60)
        handle.Text,handle.TextColor3,handle.Font,handle.TextSize="DRAG: "..string.upper(panel.Name),Color3.fromRGB(255,255,235),Enum.Font.GothamBold,12
        handle.ZIndex,handle.Visible,handle.Parent=20,false,panel
        armyStyle(handle,6)
        handles[panel]=handle
        connect(handle.InputBegan,function(input)
            if not editing or (input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch) then return end
            drag={panel=panel,input=input,start=input.Position,origin=panel.AbsolutePosition-root.AbsolutePosition,touch=input.UserInputType==Enum.UserInputType.Touch}
        end)
    end
    for _,panel in ipairs(panels) do registerPanel(panel) end
    connect(UIS.InputChanged,function(input)
        if not drag then return end
        if drag.touch and input~=drag.input then return end
        if not drag.touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local point=drag.origin+Vector2.new(input.Position.X-drag.start.X,input.Position.Y-drag.start.Y)
        local x,y=clampPosition(drag.panel,point.X,point.Y)
        drag.panel.AnchorPoint=Vector2.new(0,0)
        drag.panel.Position=UDim2.fromScale(x/math.max(1,root.AbsoluteSize.X),y/math.max(1,root.AbsoluteSize.Y))
        drag.panel:SetAttribute("CustomHUDPosition",true)
    end)
    connect(UIS.InputEnded,function(input)
        if drag and (input==drag.input or (not drag.touch and input.UserInputType==Enum.UserInputType.MouseButton1)) then drag=nil end
    end)
    connect(game.DescendantAdded,function(obj) muteObject(obj) reduce(obj) end)
    local self={}
    function self:RegisterPanel(panel) table.insert(panels,panel) registerPanel(panel) end
    function self:IsEditing() return editing end
    function self:ShowSquad() return squadWanted or editing end
    function self:Update()
        open.Text=editing and "DONE" or "SETTINGS"
        -- Re-clamp custom panels after window resize/phone rotation.
        for _,panel in ipairs(panels) do
            if panel:GetAttribute("CustomHUDPosition") then
                local relative=panel.AbsolutePosition-root.AbsolutePosition
                local x,y=clampPosition(panel,relative.X,relative.Y)
                panel.Position=UDim2.fromScale(x/math.max(1,root.AbsoluteSize.X),y/math.max(1,root.AbsoluteSize.Y))
            end
        end
    end
    function self:Destroy()
        for _,c in ipairs(connections) do c:Disconnect() end
        restoreMusic() restoreGraphics() gui:Destroy()
    end
    return self
end
return Settings
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
